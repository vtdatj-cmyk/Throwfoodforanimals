local function getPlayerMoney()
    local success, money = pcall(function()
        if DataController and DataController.Get then
            local m = DataController:Get("Money") or DataController:Get("Cash") or DataController:Get("Coins")
            if m then return m end
        end
        if LocalPlayer:FindFirstChild("leaderstats") then
            local stat = LocalPlayer.leaderstats:FindFirstChild("Money") or LocalPlayer.leaderstats:FindFirstChild("Cash") or LocalPlayer.leaderstats:FindFirstChild("Coins")
            if stat then return stat.Value end
        end
        return 0
    end)
    return success and money or 0
end

