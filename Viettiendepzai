        end
    end
    return contentArea:FindFirstChild("Auto Farm")
end

local function updateTopAfkFrames()
    local autoFarmPage = getAutoFarmTargetContainer()
    if not autoFarmPage then return end

    if not autoRunning then
        for _, child in ipairs(autoFarmPage:GetChildren()) do
            if (child:IsA("Frame") and child.Name:match("^TopAfkRow_")) or child.Name == "TopAfkHeader" then 
                child:Destroy() 
            end
        end
        return
    end

    if DataController then
        local animals = DataController:Get("Animals") or {}
        local bestIncome = LocalPlayer:GetAttribute("BestIncome") or 0

        for id, entry in pairs(animals) do
            if isFirstLoadTopAfk then
                seenPetIds[id] = true
            elseif not seenPetIds[id] then
                seenPetIds[id] = true
                entry.RealId = id
                
                local modelName = entry.ModelName
                local petName = AnimalNamesMap[modelName] or modelName
                local sellPrice, incomeVal = 0, 0
                if Mutations then
                    pcall(function()
                        sellPrice = Mutations.SellPrice(entry, bestIncome)
                        incomeVal = Mutations.IncomeOf(entry, bestIncome)
                    end)
                end

                local rarityName = getPetRarity(entry)
                local rarityInfo = RarityConfig.Get(rarityName)

                table.insert(collectedTopAfkPets, {
                    ModelName = modelName,
                    PetName = petName,
                    Mutation = entry.Mutation,
                    RawIncome = incomeVal,
                    FormattedPrice = NumberFormat and NumberFormat.Money(sellPrice) or tostring(sellPrice),
                    FormattedIncome = NumberFormat and NumberFormat.Money(incomeVal) or tostring(incomeVal),
                    RarityName = rarityInfo.Name or rarityName,
                    RarityColor = rarityInfo.Color or Color3.fromRGB(190, 190, 200)
                })
            end
        end
        isFirstLoadTopAfk = false
    end

    table.sort(collectedTopAfkPets, function(a, b)
        return a.RawIncome > b.RawIncome
    end)

    for _, child in ipairs(autoFarmPage:GetChildren()) do
        if child:IsA("Frame") and child.Name:match("^TopAfkRow_") then 
            child:Destroy() 
        end
    end

    local headerLbl = autoFarmPage:FindFirstChild("TopAfkHeader")
    if not headerLbl then
        headerLbl = Instance.new("TextLabel")
        headerLbl.Name = "TopAfkHeader"
        headerLbl.Size = UDim2.new(1, 0, 0, 30)
        headerLbl.BackgroundTransparency = 1
        headerLbl.Text = "🔥 Top Afk - Pets đã kiếm được"
        headerLbl.TextColor3 = Color3.fromRGB(255, 220, 100)
        headerLbl.TextSize = 14
        headerLbl.Font = Enum.Font.GothamBold
        headerLbl.TextXAlignment = Enum.TextXAlignment.Left
        headerLbl.Parent = autoFarmPage
    end

    for i = 1, #collectedTopAfkPets, 2 do
        local rowFrame = Instance.new("Frame")
        rowFrame.Name = "TopAfkRow_" .. tostring(i)
        rowFrame.Size = UDim2.new(1, 0, 0, 110)
        rowFrame.BackgroundTransparency = 1
        rowFrame.Parent = autoFarmPage

        for col = 1, 2 do
            local petIndex = i + col - 1
            local petData = collectedTopAfkPets[petIndex]

            if petData then
                local petCard = Instance.new("Frame")
                petCard.Size = UDim2.new(0.485, 0, 1, -5)
                petCard.Position = UDim2.new(col == 1 and 0 or 0.515, 0, 0, 0)
                petCard.BackgroundColor3 = Color3.fromRGB(14, 46, 31)
                petCard.BackgroundTransparency = 0.25
                petCard.BorderSizePixel = 0
                petCard.Parent = rowFrame

                Instance.new("UICorner", petCard).CornerRadius = UDim.new(0, 8)
                local stroke = Instance.new("UIStroke", petCard)
                stroke.Color = Color3.fromRGB(45, 130, 90)
                stroke.Transparency = 0.55

                local viewport = Instance.new("ViewportFrame")
                viewport.Size = UDim2.new(0, 48, 0, 48)
                viewport.Position = UDim2.new(0, 6, 0, 6)
                viewport.BackgroundColor3 = Color3.fromRGB(6, 20, 14)
                viewport.BackgroundTransparency = 0.3
                viewport.Parent = petCard
                Instance.new("UICorner", viewport).CornerRadius = UDim.new(0, 6)

                task.spawn(function()
                    local model = nil
                    local attempts = 0
                    while not model and attempts < 5 and AnimalUtil do
                        attempts = attempts + 1
                        pcall(function() model = AnimalUtil.Create(petData.ModelName) end)
                        if not model then task.wait(0.2) end
                    end
                    if model then
                        pcall(function()
                            if Mutations then Mutations.Apply(model, petData.Mutation, { Particles = false }) end
                            model.Parent = viewport
                            local cam = Instance.new("Camera", model)
                            viewport.CurrentCamera = cam
                            local cf, size = model:GetBoundingBox()
                            local maxDim = math.max(size.X, size.Y, size.Z)
                            if maxDim == 0 then maxDim = 3 end
                            cam.CFrame = CFrame.new(cf.Position + Vector3.new(maxDim * 1.5, maxDim * 1.1, maxDim * 1.5), cf.Position)
                        end)
                    end
                end)

                local nameLbl = Instance.new("TextLabel", petCard)
                nameLbl.Size = UDim2.new(1, -58, 0, 16)
                nameLbl.Position = UDim2.new(0, 58, 0, 4)
                nameLbl.BackgroundTransparency = 1
                nameLbl.Text = petData.PetName
                nameLbl.TextColor3 = Color3.fromRGB(240, 253, 244)
                nameLbl.TextSize = 12
                nameLbl.Font = Enum.Font.GothamBold
                nameLbl.TextXAlignment = Enum.TextXAlignment.Left

