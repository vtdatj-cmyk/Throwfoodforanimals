ExtraTab:CreateToggle({
    Name = "Auto Buy Food",
    CurrentValue = false,
    Callback = function(Value)
        autoBuyShop = Value
        if autoBuyShop then
            Window:Notify({Title = "Auto Shop", Content = "Auto Shop Buy Enabled", Duration = 2.5})
            task.spawn(function()
                while autoBuyShop do
                    pcall(function()
                        local shopEvent = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Shop_Buy")
                        if shopEvent and FoodsConfig and BalanceCurve then
                            local currentMoney = getPlayerMoney()
                            for i = 1, FoodsConfig.CountAll() do
                                if not autoBuyShop then break end
                                local foodData = FoodsConfig.GetAny(i)
                                if foodData then
                                    local isOwned = false
                                    if DataController and DataController.GetPath then
                                        isOwned = DataController:GetPath("OwnedFoods." .. foodData.Index) == true
                                    end
                                    if not isOwned then
                                        local itemPrice = BalanceCurve.GetItemPrice(LocalPlayer, foodData)
                                        if itemPrice and currentMoney >= itemPrice then
                                            shopEvent:InvokeServer(i)
                                            currentMoney = currentMoney - itemPrice
                                            task.wait(0.5)
                                        end
                                    end
                                end
                            end
                        end
                    end)
                    task.wait(5)
                end
            end)
        else
            Window:Notify({Title = "Auto Shop", Content = "Auto Shop Buy Disabled", Duration = 2.5})
        end
    end
})

