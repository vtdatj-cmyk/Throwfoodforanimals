-- Nạp thư viện UI an toàn
local successUI, EmeraldField = pcall(function()
    return loadstring(game:HttpGet("https://raw.githubusercontent.com/vtdatj-cmyk/UiLibraly/refs/heads/main/StudsUiBeta"))()
end)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Controllers = LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("Client"):WaitForChild("Controllers")

local function safeRequire(mod)
    local ok, res = pcall(require, mod)
    return ok and res or nil
end

local ClientState = safeRequire(Controllers:FindFirstChild("ClientState"))

-- [CHẶN TẬN GỐC] Hook đè phương thức Remotes.Invoke để chặn hoàn toàn lệnh Shop_Prompt bật bảng mua Robux
pcall(function()
    local oldInvoke
    oldInvoke = hookfunction(Remotes.Invoke, function(name, ...)
        local args = {...}
        -- Nếu game cố gắng gọi lệnh mở bảng prompt mua Super Throw hoặc sản phẩm, chặn ngay lập tức
        if type(name) == "string" and (name == "Shop_Prompt" or name == "PromptProduct") then
            return {Ok = false, Reason = "BlockedByScript"}
        end
        return oldInvoke(name, unpack(args))
    end)
end)

if successUI and EmeraldField and type(EmeraldField) == "table" and EmeraldField.CreateWindow then
    local Window = EmeraldField:CreateWindow({
        Name = "Throw Food For Amimals",
        Subtitle = "Script Beta"
    })

    local MainTab = Window:CreateTab("Auto Farm")
    MainTab:CreateSection("Main Controls")

    local autoRunning = false
    local autoTraining = false
    local autoTrainingBonus = false
    local autoSuperThrow = false 
    local throwResolveValue = 20 
    local trainingDelayTime = 2 
    local targetPos = Vector3.new(-0.5, 50, -34)

    if getgenv().TrainingBonusConn then
        pcall(function()
            getgenv().TrainingBonusConn:Disconnect()
        end)
        getgenv().TrainingBonusConn = nil
    end

    getgenv().TrainingBonusConn = Remotes.Event("Training_Bonus").OnClientEvent:Connect(function(bonusId, expireTime)
        if autoTrainingBonus and bonusId then
            task.spawn(function()
                task.wait(0.02)
                pcall(function()
                    Remotes.Invoke("Training_TapBonus", bonusId)
                end)
            end)
        end
    end)

    local function instantTeleport(destinationCFrame)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return false end

        hum.PlatformStand = false
        hum.Sit = false
        hrp.Anchored = false
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = destinationCFrame
        return true
    end

    local function executeTrainingSequence()
        local localProps = workspace:FindFirstChild("LocalPlotProps")
        local targetPart = localProps and localProps:FindFirstChild("TrainingArea")

        if targetPart then
            local targetCFrame
            if targetPart:IsA("BasePart") then
                targetCFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
            elseif targetPart:IsA("Model") and targetPart.PrimaryPart then
                targetCFrame = targetPart:GetPrimaryPartCFrame() + Vector3.new(0, 3, 0)
            else
                local firstPart = targetPart:FindFirstChildWhichIsA("BasePart", true)
                if firstPart then
                    targetCFrame = firstPart.CFrame + Vector3.new(0, 3, 0)
                end
            end

            if targetCFrame then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - targetCFrame.Position).Magnitude > 2 then
                    instantTeleport(targetCFrame)
                end
            end
        end

        if not ClientState or ClientState.Busy ~= "Training" then
            pcall(function()
                Remotes.Invoke("Training_Start")
            end)
        end
    end

    -- Xử lý vòng lặp Bypass Super Throw ngầm mà không cần bật bảng mua
    task.spawn(function()
        while true do
            if autoSuperThrow then
                pcall(function()
                    local grantedEvent = Remotes.Event("Throw_SuperGranted")
                    if grantedEvent then
                        grantedEvent:Fire({Armed = true, Single = true})
                    end
                end)
            end
            task.wait(2)
        end
    end)

    MainTab:CreateToggle({
        Name = "Auto Farm",
        CurrentValue = false,
        Callback = function(Value)
            autoRunning = Value
            if autoRunning then
                Window:Notify({Title = "Auto Farm", Content = "Auto Farm Enabled", Duration = 2.5})
                task.spawn(function()
                    while autoRunning do
                        pcall(function()
                            local char = LocalPlayer.Character
                            local hrp = char and char:FindFirstChild("HumanoidRootPart")

                            if autoTraining and ClientState and ClientState.Busy == "Training" then
                                pcall(function() Remotes.Invoke("Training_Stop") end)
                                task.wait(0.1)
                            end

                            if hrp then
                                if (hrp.Position - targetPos).Magnitude > 1.5 then
                                    instantTeleport(CFrame.new(targetPos))
                                end

                                local startResult = Remotes.Invoke("Throw_Start")
                                if startResult and startResult.Ok then
                                    local resolveResult = Remotes.Invoke("Throw_Resolve", throwResolveValue)

                                    if resolveResult and resolveResult.Ok then
                                        pcall(function() Remotes.Invoke("Throw_Complete") end)
                                    end

                                    if autoTraining then
                                        executeTrainingSequence()
                                        local waitStart = os.clock()
                                        while autoRunning and autoTraining and os.clock() - waitStart < trainingDelayTime do
                                            task.wait(0.2)
                                        end
                                    end
                                else
                                    pcall(function() Remotes.Invoke("Throw_Cancel") end)
                                end
                            end
                        end)
                        task.wait(0.2)
                    end
                end)
            else
                Window:Notify({Title = "Auto Farm", Content = "Auto Farm Disabled", Duration = 2.5})
            end
        end
    })

    MainTab:CreateToggle({
        Name = "Super Throw (Bypass Toggle)",
        CurrentValue = false,
        Callback = function(Value)
            autoSuperThrow = Value
            if autoSuperThrow then
                Window:Notify({Title = "Super Throw", Content = "Super Throw Bypass Enabled!", Duration = 2.5})
            else
                Window:Notify({Title = "Super Throw", Content = "Super Throw Bypass Disabled", Duration = 2.5})
            end
        end
    })

    MainTab:CreateToggle({
        Name = "Auto Training",
        CurrentValue = false,
        Callback = function(Value)
            autoTraining = Value
            if autoTraining then
                Window:Notify({Title = "Auto Training", Content = "Auto Training Enabled", Duration = 2.5})
                task.spawn(function()
                    while autoTraining do
                        if not autoRunning then
                            pcall(function()
                                executeTrainingSequence()
                            end)
                        end
                        task.wait(1)
                    end
                end)
            else
                pcall(function()
                    Remotes.Invoke("Training_Stop")
                end)
                Window:Notify({Title = "Auto Training", Content = "Auto Training Disabled", Duration = 2.5})
            end
        end
    })

    MainTab:CreateToggle({
        Name = "Auto Training Bonus",
        CurrentValue = false,
        Callback = function(Value)
            autoTrainingBonus = Value
            if autoTrainingBonus then
                Window:Notify({Title = "Training Bonus", Content = "Auto Training Bonus Enabled", Duration = 2.5})
                
                task.spawn(function()
                    while autoTrainingBonus do
                        pcall(function()
                            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                            local trainingSeq = playerGui and playerGui:FindFirstChild("TrainingSequence")
                            local tapLayer = trainingSeq and trainingSeq:FindFirstChild("TapBonusLayer")
                            local btn = tapLayer and tapLayer:FindFirstChild("TapBonus")

                            if btn and btn:IsA("ImageButton") and btn.Parent then
                                local uiScale = btn:FindFirstChildOfClass("UIScale")
                                local VirtualInputManager = game:GetService("VirtualInputManager")
                                local GuiService = game:GetService("GuiService")
                                if not uiScale or uiScale.Scale > 0.4 then
                                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.ButtonX, false, game)
                                    task.wait(0.02)
                                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.ButtonX, false, game)

                                    local inset = GuiService:GetGuiInset()
                                    local pos = btn.AbsolutePosition
                                    local size = btn.AbsoluteSize
                                    if size.X > 5 and size.Y > 5 then
                                        local clickX = pos.X + (size.X / 2) + inset.X
                                        local clickY = pos.Y + (size.Y / 2) + inset.Y
                                        VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, true, game, 1)
                                        task.wait(0.02)
                                        VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, false, game, 1)
                                    end
                                end
                            end
                        end)
                        task.wait(0.12)
                    end
                end)
            else
                Window:Notify({Title = "Training Bonus", Content = "Auto Training Bonus Disabled", Duration = 2.5})
            end
        end
    })

    MainTab:CreateSlider({
        Name = "Training Rest Time (Delay)",
        Range = {2, 10},
        Increment = 1,
        CurrentValue = 2,
        Flag = "TrainingDelaySlider",
        Callback = function(Value)
            trainingDelayTime = Value
        end
    })

    MainTab:CreateSlider({
        Name = "Throw_Resolve Force",
        Range = {0, 20},
        Increment = 1,
        CurrentValue = 20,
        Flag = "ThrowResolveSlider",
        Callback = function(Value)
            throwResolveValue = Value
        end
    })
else
    warn("UI Library failed to load.")
end
