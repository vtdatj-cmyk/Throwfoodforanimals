local autoFarmThreadActive = false
local function startAutoFarmLoop()
    if autoFarmThreadActive then return end
    autoFarmThreadActive = true
    task.spawn(function()
        while autoRunning do
            pcall(function()
                if not Remotes then return end
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if autoTraining and ClientState and ClientState.Busy == "Training" then
                    pcall(function() Remotes.Invoke("Training_Stop") end)
                    task.wait(0.1)
                end
                if hrp then
                    if (hrp.Position - targetPos).Magnitude > 1.5 then instantTeleport(CFrame.new(targetPos)) end
                    local startResult = Remotes.Invoke("Throw_Start")
                    if startResult and startResult.Ok then
                        local resolveResult = Remotes.Invoke("Throw_Resolve", throwResolveValue)
                        if resolveResult and resolveResult.Ok then pcall(function() Remotes.Invoke("Throw_Complete") end) end
                        if autoTraining then
                            executeTrainingSequence()
                            local waitStart = os.clock()
                            while autoRunning and autoTraining and os.clock() - waitStart < trainingDelayTime do task.wait(0.2) end
                        end
                    else
                        pcall(function() Remotes.Invoke("Throw_Cancel") end)
                    end
                end
            end)
            task.wait(0.2)
        end
        autoFarmThreadActive = false
    end)
end

