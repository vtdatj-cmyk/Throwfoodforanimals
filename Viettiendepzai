local function equipPetTool(petId, petDisplayName)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChild("Backpack")

    if hum and backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local attrId = tool:GetAttribute("Id") or tool:GetAttribute("AnimalId") or tool:GetAttribute("PetId")
                if (attrId and tostring(attrId) == tostring(petId)) or (petDisplayName and tool.Name:lower():find(petDisplayName:lower(), 1, true)) then
                    hum:EquipTool(tool)
                    return true
                end
            end
        end
    end

    local success = false
    if Remotes then
        for _, name in ipairs({"Inventory_Equip", "Tool_Equip", "Animal_Hold"}) do
            pcall(function()
                if Remotes.Invoke then Remotes.Invoke(name, petId) success = true
                elseif Remotes.Fire then Remotes.Fire(name, petId) success = true end
            end)
            if success then break end
        end
    end
    return success
end

