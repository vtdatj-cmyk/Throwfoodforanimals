                    local currentFence = DataController:Get("FenceLevel") or 0
                    local nextFenceConfig = FenceConfig.Get(currentFence + 1)
                    local money = DataController:Get("Money") or 0
                    if nextFenceConfig and nextFenceConfig.Price and money >= nextFenceConfig.Price then
                        Remotes.Invoke("Plot_UpgradeFence")
                    end
                end
            end)
            task.wait(2)
        end
        fenceThreadActive = false
    end)
end

local foodThreadActive = false
local function startBuyFoodLoop()
    if foodThreadActive then return end
    foodThreadActive = true
    task.spawn(function()
        while autoBuyFood do
            pcall(function()
                if DataController and FoodsConfig and BalanceCurve and Remotes then
                    local totalFoods = FoodsConfig.CountAll()
                    local money = DataController:Get("Money") or 0
                    for i = 1, totalFoods do
                        if not autoBuyFood then break end
                        local foodData = FoodsConfig.GetAny(i)
                        if foodData and not FoodsConfig.IsLocked(foodData.Index) then
                            if not DataController:GetPath("OwnedFoods." .. foodData.Index) and money >= BalanceCurve.GetItemPrice(LocalPlayer, foodData) then
                                Remotes.Invoke("Shop_Buy", i)
                                task.wait(0.5)
                            end
                        end
                    end
                end
            end)
            task.wait(3)
        end
        foodThreadActive = false
    end)
end

