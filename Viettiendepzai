local PetBackpackTab = Window:CreateTab("Pet Backpack")

local function getTargetContainer()
    local parentGui = (gethui and gethui()) or game:GetService("CoreGui")
    local uiInstance = parentGui:FindFirstChild("EmeraldFieldUI") or LocalPlayer.PlayerGui:FindFirstChild("EmeraldFieldUI")
    if not uiInstance then return nil end
    local main = uiInstance:FindFirstChild("Main")
    if not main then return nil end
    local contentArea = main:FindFirstChild("ContentArea")
    if not contentArea then return nil end
    
    for _, child in ipairs(contentArea:GetChildren()) do
        if child.Name:lower():gsub("%s+", "") == "petbackpack" then
            return child
        end
    end
    return contentArea:FindFirstChild("Pet Backpack")
end

local function updateBackpackFrames()
    local tab3Page = getTargetContainer()
    if not tab3Page then return end

    for _, child in ipairs(tab3Page:GetChildren()) do
        if child:IsA("Frame") and child.Name:match("^PetRowGrid_") then child:Destroy() end
    end

    if not DataController then return end
    local animals = DataController:Get("Animals") or {}
    local bestIncome = LocalPlayer:GetAttribute("BestIncome") or 0

    local unplacedPets = {}
    for id, entry in pairs(animals) do
        if not entry.Placed then
            entry.RealId = id
            
            local incomeVal = 0
            if Mutations then
                pcall(function() incomeVal = Mutations.IncomeOf(entry, bestIncome) end)
            end
            entry.RawIncome = incomeVal
            
            table.insert(unplacedPets, entry)
        end
    end

    table.sort(unplacedPets, function(a, b)
        return (a.RawIncome or 0) > (b.RawIncome or 0)
    end)

    for i = 1, #unplacedPets, 2 do
        local rowFrame = Instance.new("Frame")
        rowFrame.Name = "PetRowGrid_" .. tostring(i)
        rowFrame.Size = UDim2.new(1, 0, 0, 145)
        rowFrame.BackgroundTransparency = 1
        rowFrame.Parent = tab3Page

        for col = 1, 2 do
            local petIndex = i + col - 1
            local entry = unplacedPets[petIndex]

            if entry then
                local modelName = entry.ModelName
                local petName = AnimalNamesMap[modelName] or modelName
                local sellPrice, incomeVal = 0, entry.RawIncome or 0
                if Mutations then
                    pcall(function()
                        sellPrice = Mutations.SellPrice(entry, bestIncome)
                    end)
                end

                local formattedPrice = NumberFormat and NumberFormat.Money(sellPrice) or tostring(sellPrice)
                local formattedIncome = NumberFormat and NumberFormat.Money(incomeVal) or tostring(incomeVal)

                local rarityName = getPetRarity(entry)
                local rarityInfo = RarityConfig.Get(rarityName)

                local petCard = Instance.new("Frame")
                petCard.Size = UDim2.new(0.485, 0, 1, 0)
                petCard.Position = UDim2.new(col == 1 and 0 or 0.515, 0, 0, 0)
                petCard.BackgroundColor3 = Color3.fromRGB(14, 46, 31)
                petCard.BackgroundTransparency = 0.25
                petCard.BorderSizePixel = 0
                petCard.Parent = rowFrame

                Instance.new("UICorner", petCard).CornerRadius = UDim.new(0, 8)
                local stroke = Instance.new("UIStroke", petCard)
                stroke.Color = Color3.fromRGB(45, 130, 90)
                stroke.Transparency = 0.55

                local viewport = Instance.new("ViewportFrame")
                viewport.Size = UDim2.new(0, 48, 0, 48)
                viewport.Position = UDim2.new(0, 6, 0, 6)
                viewport.BackgroundColor3 = Color3.fromRGB(6, 20, 14)
                viewport.BackgroundTransparency = 0.3
                viewport.Parent = petCard
                Instance.new("UICorner", viewport).CornerRadius = UDim.new(0, 6)

                task.spawn(function()
                    local model = nil
                    local attempts = 0
                    while not model and attempts < 5 and AnimalUtil do
                        attempts = attempts + 1
                        pcall(function() model = AnimalUtil.Create(modelName) end)
                        if not model then task.wait(0.2) end
                    end
                    if model then
                        pcall(function()
                            if Mutations then Mutations.Apply(model, entry.Mutation, { Particles = false }) end
                            model.Parent = viewport
                            local cam = Instance.new("Camera", model)
                            viewport.CurrentCamera = cam
                            local cf, size = model:GetBoundingBox()
                            local maxDim = math.max(size.X, size.Y, size.Z)
                            if maxDim == 0 then maxDim = 3 end
                            cam.CFrame = CFrame.new(cf.Position + Vector3.new(maxDim * 1.5, maxDim * 1.1, maxDim * 1.5), cf.Position)
                        end)
                    end
                end)

                local nameLbl = Instance.new("TextLabel", petCard)
                nameLbl.Size = UDim2.new(1, -58, 0, 16)
                nameLbl.Position = UDim2.new(0, 58, 0, 4)
                nameLbl.BackgroundTransparency = 1
                nameLbl.Text = petName
                nameLbl.TextColor3 = Color3.fromRGB(240, 253, 244)
                nameLbl.TextSize = 12
                nameLbl.Font = Enum.Font.GothamBold
                nameLbl.TextXAlignment = Enum.TextXAlignment.Left

                local rarityLbl = Instance.new("TextLabel", petCard)
                rarityLbl.Size = UDim2.new(1, -58, 0, 14)
                rarityLbl.Position = UDim2.new(0, 58, 0, 20)
                rarityLbl.BackgroundTransparency = 1
                rarityLbl.Text = "★ " .. (rarityInfo.Name or rarityName)
                rarityLbl.TextColor3 = rarityInfo.Color or Color3.fromRGB(190, 190, 200)
                rarityLbl.TextSize = 10
                rarityLbl.Font = Enum.Font.GothamBold
                rarityLbl.TextXAlignment = Enum.TextXAlignment.Left

                local priceLbl = Instance.new("TextLabel", petCard)
                priceLbl.Size = UDim2.new(1, -58, 0, 14)
                priceLbl.Position = UDim2.new(0, 58, 0, 36)
                priceLbl.BackgroundTransparency = 1
                priceLbl.Text = "💰 " .. formattedPrice
                priceLbl.TextColor3 = Color3.fromRGB(52, 211, 153)
                priceLbl.TextSize = 10
                priceLbl.Font = Enum.Font.GothamSemibold
                priceLbl.TextXAlignment = Enum.TextXAlignment.Left

                local incomeLbl = Instance.new("TextLabel", petCard)
                incomeLbl.Size = UDim2.new(1, -58, 0, 14)
                incomeLbl.Position = UDim2.new(0, 58, 0, 52)
                incomeLbl.BackgroundTransparency = 1
                incomeLbl.Text = "⚡ " .. formattedIncome .. "/s"
                incomeLbl.TextColor3 = Color3.fromRGB(255, 220, 100)
                incomeLbl.TextSize = 10
                incomeLbl.Font = Enum.Font.GothamSemibold
                incomeLbl.TextXAlignment = Enum.TextXAlignment.Left

                local equipBtn = Instance.new("TextButton", petCard)
                equipBtn.Size = UDim2.new(1, -10, 0, 20)
                equipBtn.Position = UDim2.new(0, 5, 0, 68)
                equipBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 200)
                equipBtn.Text = "Equip Tool"
                equipBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                equipBtn.TextSize = 10
                equipBtn.Font = Enum.Font.GothamBold
                Instance.new("UICorner", equipBtn).CornerRadius = UDim.new(0, 4)

                equipBtn.MouseButton1Click:Connect(function()
                    equipPetTool(entry.RealId, petName)
                    Window:Notify({Title = "Pet Backpack", Content = "Equipped tool: " .. tostring(petName), Duration = 1.5})
                end)

                local sellBtn = Instance.new("TextButton", petCard)
                sellBtn.Size = UDim2.new(1, -10, 0, 20)
                sellBtn.Position = UDim2.new(0, 5, 0, 91)
                sellBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
                sellBtn.Text = "Sell"
                sellBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                sellBtn.TextSize = 10
                sellBtn.Font = Enum.Font.GothamBold
                Instance.new("UICorner", sellBtn).CornerRadius = UDim.new(0, 4)

                sellBtn.MouseButton1Click:Connect(function()
                    petCard:Destroy()
                    sellPetRemote(entry.RealId)
                    Window:Notify({Title = "Pet Backpack", Content = "Sold pet: " .. tostring(petName), Duration = 1.5})
                    
                    task.delay(0.3, function()
                        pcall(updateBackpackFrames)
                    end)
                end)
            end
        end
    end
end

