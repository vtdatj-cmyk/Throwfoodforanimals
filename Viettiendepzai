local autoSellEnabled = SavedConfig.AutoSellEnabled == true
local minSellPriceThreshold = SavedConfig.MinSellPriceThreshold or 100
local autoEquipBestEnabled = SavedConfig.AutoEquipBestEnabled == true
local autoFillSlotsEnabled = SavedConfig.AutoFillSlotsEnabled == true

local function processNewPets()
    if not DataController or not Mutations then return end
    local animals = DataController:Get("Animals") or {}
    local bestIncome = LocalPlayer:GetAttribute("BestIncome") or 0

    if autoSellEnabled then
        for id, entry in pairs(animals) do
            if not entry.Placed then
                local sellPrice = 0
                pcall(function() sellPrice = Mutations.SellPrice(entry, bestIncome) end)
                if sellPrice < minSellPriceThreshold then
                    sellPetRemote(id)
                end
            end
        end
    end

    if autoEquipBestEnabled then
        pcall(function()
            local placedMaxPrice = 0
            local backpackMaxPrice = 0
            for _, entry in pairs(animals) do
                local price = 0
                pcall(function() price = Mutations.SellPrice(entry, bestIncome) end)
                if entry.Placed then
                    if price > placedMaxPrice then placedMaxPrice = price end
                else
                    if price > backpackMaxPrice then backpackMaxPrice = price end
                end
            end
            if backpackMaxPrice > placedMaxPrice then
                equipBestPetRemote()
            end
        end)
    end

    if autoFillSlotsEnabled then
        pcall(function()
            local placedCount = 0
            local unplacedPets = {}
            for id, entry in pairs(animals) do
                if entry.Placed then
                    placedCount = placedCount + 1
                else
                    table.insert(unplacedPets, {Id = id, Entry = entry})
                end
            end
            local maxSlots = LocalPlayer:GetAttribute("MaxPets") or LocalPlayer:GetAttribute("AnimalLimit") or (placedCount + #unplacedPets)
            if placedCount < maxSlots and #unplacedPets > 0 then
                local randomPet = unplacedPets[1]
                if randomPet then
                    equipSpecificPet(randomPet.Id)
                end
            end
        end)
    end
end

