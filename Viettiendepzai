-- Ánh xạ chuẩn xác theo ĐÚNG SỐ THỨ TỰ (idx) trong AnimalsData -> RarityConfig.List[idx]
local AnimalNamesMap = {}
local AnimalRarityMap = {}
if AnimalsData and RarityConfig and RarityConfig.List then
    local rarityList = RarityConfig.List
    local maxRarityIdx = #rarityList

    for _, categoryList in pairs(AnimalsData) do
        if type(categoryList) == "table" then
            for idx, petData in ipairs(categoryList) do
                if type(petData) == "table" and petData.ModelName then
                    AnimalNamesMap[petData.ModelName] = petData.Name or petData.ModelName
                    -- Lấy trực tiếp theo số thứ tự idx (1 = Common, 2 = Uncommon, 3 = Rare...)
                    local exactIdx = math.clamp(idx, 1, maxRarityIdx)
                    AnimalRarityMap[petData.ModelName] = petData.Rarity or rarityList[exactIdx].Name
                end
            end
        end
    end
end

local function getPetRarity(entry)
    if not entry then return "Common" end
    if entry.Rarity and RarityConfig.ByName[entry.Rarity] then return entry.Rarity end
    if entry.ModelName and AnimalRarityMap[entry.ModelName] then
        return AnimalRarityMap[entry.ModelName]
    end
    return "Common"
end

local function parseSmartNumber(text)
    if type(text) == "number" then return text end
    local cleanStr = string.lower(tostring(text):gsub("%s+", ""))
    local multiplier = 1
    
    if cleanStr:match("qa") then multiplier = 1e15
    elseif cleanStr:match("sx") then multiplier = 1e18
    elseif cleanStr:match("t") then multiplier = 1e12
    elseif cleanStr:match("b") then multiplier = 1e9
    elseif cleanStr:match("m") then multiplier = 1e6
    elseif cleanStr:match("k") then multiplier = 1e3
    end
    
    local num = tonumber(cleanStr:gsub("[^%d%.]", ""))
    if num then return num * multiplier end
    return tonumber(text) or 0
end

